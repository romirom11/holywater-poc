# Copy to .env and fill in what you need. A blank or whitespace-only value counts as missing:
# a required key left blank stops the run with "missing required secrets: ..." before any call.

# Required with the default config: OpenRouter serves the LLM, Seedance video, ElevenLabs TTS and
# Whisper STT with this one key (config/pipeline.yaml, every capability has provider: openrouter).
OPENROUTER_API_KEY=

# Only needed if a capability in config/pipeline.yaml says provider: fal. Lipsync is fal-only
# and off by default (audio.lipsync.enabled: false).
FAL_KEY=

# Optional: TypeSafe Jev typed judge (script pre-flight, failure classification). Needs
# `uv sync --extra judge`. Blank, refused by the SDK at start-up, or the SDK not installed: the
# run continues without the judge (WARNING judge.disabled, report.json models.judge = "noop").
TYPESAFE_API_KEY=

# Not read from this file. HW_CONFIG (path to pipeline.yaml) and HW_LOG_LEVEL (INFO, DEBUG, ...)
# are process environment variables: export them in the shell or pass --config / --log-level.
